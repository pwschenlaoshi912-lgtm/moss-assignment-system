{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moss-assignment-system",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}
